[Unit]
Description=LapseCam Timelapse Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/lapsecam
ExecStart=/usr/local/bin/lapsecam -config /etc/lapsecam/config.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
User=root

[Install]
WantedBy=multi-user.target
